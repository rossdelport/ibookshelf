# Copy this file to `.env` and fill in your key. `.env` is gitignored.
#
# Optional: Google Books API key. The app works without it, but unauthenticated
# requests are rate-limited per IP. A key raises the limit.
#
# Create one: https://console.cloud.google.com/ → enable "Books API" →
# Credentials → Create credentials → API key. RESTRICT it (recommended):
#   - API restriction: Books API only
#   - Application restriction: your iOS bundle id (com.fable.ibookshelf) /
#     Android package + SHA-1. (An EXPO_PUBLIC_ var ships in the app bundle,
#     so this restriction is what actually protects the key — not gitignore.)
#
# Must be prefixed EXPO_PUBLIC_ so Expo inlines it into the client at build time.
EXPO_PUBLIC_GOOGLE_BOOKS_API_KEY=

# Supabase — Project URL + anon/publishable key from your project's API settings.
# Both are safe to embed in the client; Row-Level Security protects the data.
# NEVER put the service_role / secret key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Sentry crash reporting. Leave blank to disable. Create a project at
# sentry.io → React Native → copy its DSN here (and into eas.json build env).
EXPO_PUBLIC_SENTRY_DSN=
