{
  "expo": {
    "name": "iBookshelf - Virtual Book Library",
    "slug": "fable-ibookshelf",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "fable",
    "ios": {
      "supportsTablet": false,
      "minimumOsVersion": "15.1",
      "bundleIdentifier": "com.fable.ibookshelf",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fable.ibookshelf"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAF8F3"
        }
      ],
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "iBookshelf uses your camera to scan book barcodes and add them to your library."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "iBookshelf uses your photo library to set a book's cover image."
        }
      ],
      "expo-apple-authentication",
      "expo-web-browser",
      "@sentry/react-native",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
